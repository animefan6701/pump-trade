HELIUS_PROJECT_ID=

SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=

PUMP_PROGRAM_ID=
LIVE_INGEST_MS=5000
INGEST_INTERVAL_MS=180000
INGEST_PUMPFUN_LIMIT=100

JITO_BUNDLE_API_URL=https://bundles.jito.wtf
