# Loaded by web/next.config.ts and web/lib/*.ts from the repo root.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pump_trade

# Host templates only. api-key is injected from the Mongo Helius pool (LIVE key).
# Do not bake a spent key here — rotation overwrites api-key= on every call.
