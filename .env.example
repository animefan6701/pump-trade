RUG_THRESHOLD=0.55
GRADUATION_THRESHOLD=0.35
AUTO_SIZE_SOL=0.1
AUTO_MAX_OPEN=20

GMI_API_KEY=gmgn_5764f33f4e442b82fefacf5ecbc52449

WALLET_ALERT_ADDRESS=
